page {

    #
    # Aktuelle TYPO3-Seite
    #
    390 = SCHEMA
    390 {
        #
        # Backend:
        # Structured Data -> Type of web page
        #
        type.field = tx_schema_webpagetype
        type.ifEmpty = WebPage

        #
        # Eindeutige URL der aktuellen Seite als @id
        #
        id {
            typolink {
                parameter.data = page:uid
                forceAbsoluteUrl = 1
                returnLast = url
            }
        }

        properties {

            #
            # TYPO3 SEO-Titel,
            # Fallback auf normalen Seitentitel
            #
            name.field = seo_title // title

            #
            # TYPO3 Meta Description
            #
            description.field = description

            #
            # Aktuelle kanonische Seiten-URL
            #
            url {
                typolink {
                    parameter.data = page:uid
                    forceAbsoluteUrl = 1
                    returnLast = url
                }
            }

            #
            # Kontaktseite mit dem Verein verbinden
            #
            about = SCHEMA
            about {
                id = https://www.svbalingen.de/#organization

                if {
                    value = ContactPage
                    equals.field = tx_schema_webpagetype
                }
            }
        }
    }


    #
    # Schachverein Balingen e.V.
    #
    400 = SCHEMA
    400 {
        type = SportsOrganization

        #
        # Stabile ID des Vereins
        #
        id = https://www.svbalingen.de/#organization

        properties {

            name = Schachverein Balingen e.V.
            alternateName = SV Balingen

            description = Schachverein Balingen e.V. – Schachverein für Erwachsene, Jugendliche und Kinder in Balingen.

            url = https://www.svbalingen.de/

            logo = https://www.svbalingen.de/_assets/254f43d4a5741df16583934520525aa6/Images/logos/logo.png

            email = info@svbalingen.de

            foundingDate = 1932

            sport = Chess

            #
            # Gemeinnütziger eingetragener Verein
            #
            nonprofitStatus = https://schema.org/DERegisteredAssociationCharity


            #
            # Vereins-/Kontaktadresse
            #
            address = SCHEMA
            address {
                type = PostalAddress

                properties {
                    streetAddress = Gaibernstraße 8
                    postalCode = 72336
                    addressLocality = Balingen
                    addressRegion = Baden-Württemberg
                    addressCountry = DE
                }
            }


            #
            # Allgemeiner Kontakt
            #
            contactPoint = SCHEMA
            contactPoint {
                type = ContactPoint

                properties {
                    contactType = general inquiries
                    email = info@svbalingen.de
                    availableLanguage = de
                }
            }


            #
            # Lokaler Tätigkeitsbereich
            #
            areaServed = SCHEMA
            areaServed {
                type = City

                properties {
                    name = Balingen
                }
            }


            #
            # Mitgliedschaft
            #
            memberOf = SCHEMA
            memberOf {
                type = SportsOrganization

                id = https://www.svw.info/#organization

                properties {
                    name = Schachverband Württemberg e.V.
                    alternateName = SVW
                    url = https://www.svw.info/
                }
            }


            #
            # Inhaltliche Schwerpunkte
            #
            knowsAbout {
                10 = Schach
                20 = Jugendschach
                30 = Turnierschach
                40 = Schnellschach
                50 = Blitzschach
                60 = Chess960
            }


            #
            # Offizielle externe Profile
            #
            sameAs {
                10 = https://www.instagram.com/schachvereinbalingen/
                20 = https://lichess.org/team/schachverein-balingen-ev

                # Facebook später ergänzen:
                # 30 = https://www.facebook.com/...
            }
        }
    }


    #
    # Spielstätte Erwachsene
    # Zollernschloss Balingen
    #
    410 = SCHEMA
    410 {
        type = Place

        id = https://www.svbalingen.de/#place-zollernschloss

        properties {

            name = Zollernschloss Balingen

            address = SCHEMA
            address {
                type = PostalAddress

                properties {
                    streetAddress = Schloßstraße 6
                    postalCode = 72336
                    addressLocality = Balingen
                    addressRegion = Baden-Württemberg
                    addressCountry = DE
                }
            }


            #
            # Donnerstag 19:30 - 23:30 Uhr
            #
            openingHoursSpecification = SCHEMA
            openingHoursSpecification {
                type = OpeningHoursSpecification

                properties {
                    dayOfWeek = https://schema.org/Thursday
                    opens = 19:30
                    closes = 23:30
                }
            }
        }
    }


    #
    # Spielstätte Jugend
    # Realschule Balingen
    #
    420 = SCHEMA
    420 {
        type = Place

        id = https://www.svbalingen.de/#place-realschule

        properties {

            name = Realschule Balingen

            address = SCHEMA
            address {
                type = PostalAddress

                properties {
                    streetAddress = Teckstraße 20
                    postalCode = 72336
                    addressLocality = Balingen
                    addressRegion = Baden-Württemberg
                    addressCountry = DE
                }
            }


            #
            # Samstag 14:00 - 16:00 Uhr
            #
            openingHoursSpecification = SCHEMA
            openingHoursSpecification {
                type = OpeningHoursSpecification

                properties {
                    dayOfWeek = https://schema.org/Saturday
                    opens = 14:00
                    closes = 16:00
                }
            }
        }
    }
}